# Arranjo Consultoria · configuração do servidor (Apache / Locaweb)
Options -Indexes
DirectoryIndex index.html

# HTTPS e domínio principal: ative as 4 linhas abaixo (tire o #) SOMENTE depois
# que https://arranjoconsultoria.com.br abrir com o cadeado no navegador.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://arranjoconsultoria.com.br%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
